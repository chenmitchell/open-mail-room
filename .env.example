# Open Mail Room — environment configuration
#
# Copy to `.env` and fill in. For a normal self-hosted install you don't need
# to do this by hand: `deploy/deploy.sh` generates a working `.env` (including
# freshly generated keys) on first run.
#
# Every variable below is actually read by the application. If a setting you
# want isn't here, it's configured somewhere else on purpose -- see
# "Configured elsewhere" at the bottom before adding lines that will silently
# do nothing.

# === Database =========================================================
# Default: SQLite, file-based, no extra service. Genuinely fine for one office.
DATABASE_URL=sqlite:///./data/openmailroom.db

# PostgreSQL (docker compose --profile postgres):
# DATABASE_URL=postgresql://openmailroom:password@postgres:5432/openmailroom
# POSTGRES_PASSWORD is read by the postgres container, not by the app.
# POSTGRES_PASSWORD=your-postgres-password

# === Security keys ====================================================
# Generate each with:  openssl rand -base64 32
#
# ENCRYPTION_KEY decrypts every stored photo and every encrypted personal
# field. Lose it and that data is unrecoverable -- nobody can help you. Back it
# up somewhere that is not this server, today. Leak it and treat every photo
# and personal field as leaked.
#
# In production, a key that isn't valid base64 of exactly 32 bytes is a hard
# startup error. There is deliberately no silent weak-key fallback.

# Signs sessions / JWT / CSRF. Rotating it logs everyone out; data is fine.
SECRET_KEY=your-random-32-byte-secret-key-here

# Encrypts personal fields and uploaded files.
ENCRYPTION_KEY=your-base64-32-byte-encryption-key-here

# --- Key rotation (optional) ---
# Ciphertext carries the key version that wrote it as a prefix, so old rows
# keep decrypting as long as their key stays registered. To rotate: add a new
# version, point ENCRYPTION_ACTIVE_KEY at it, and KEEP the old one -- removing
# a version that still has data written under it deletes that data in practice.
#
# The single ENCRYPTION_KEY above is registered as "k1" (and "v1", for
# ciphertext written by pre-rotation versions), so ignore these until you
# actually rotate.
# ENCRYPTION_KEYS={"k1": "<base64 32-byte key>", "k2": "<base64 32-byte key>"}
# ENCRYPTION_ACTIVE_KEY=k2

# === Environment ======================================================
# production | development
# Production enforces Secure cookies and the strict key validation above.
# Never set `development` on a real deployment.
ENVIRONMENT=production

# === First admin ======================================================
# Seeded on first startup by scripts/seed.py (idempotent). Change the password
# from the UI after first login.
#
# If BOTH are set, the admin is created at startup and you land on the login
# page. Leave ADMIN_PASSWORD unset and the first-run setup wizard asks you to
# choose one in the browser instead. deploy.sh sets both, generating a random
# password and printing it once.
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# === Domain & HTTPS ===================================================
# Read by deploy/docker-compose.yml + Caddy, not by the app. Caddy fetches a
# Let's Encrypt certificate for this name automatically.
#
# Camera capture needs HTTPS: browsers block getUserMedia on insecure origins,
# so a plain-HTTP install means the phone camera page silently does nothing.
#
# Internal-only, no public domain: run deploy/selfsigned.sh and point Caddy at
# the generated cert (see docs/INSTALL.md).
DOMAIN=mailroom.example.com

# Public URL used in outbound links (e.g. the login link in the welcome
# email). Set when the app is behind a proxy and can't infer its own address.
# PUBLIC_BASE_URL=https://mailroom.example.com

# === Auth tuning ======================================================
# Session/JWT lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Login lockout. An independent per-IP limiter (5 failed attempts / 60s) is
# always on and is not configurable.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Cookie flags aren't configurable: HttpOnly and SameSite=Lax are fixed, and
# Secure is derived from ENVIRONMENT (on whenever it isn't `development`).

# === AI OCR ===========================================================
# Normally configured in the admin UI (Admin -> AI 設定), where keys are
# encrypted at rest with the same key registry as personal data. These env vars
# exist for automated/CI deploys; a key set here sits in plaintext on disk, so
# prefer the UI.
#
# You bring your own key -- this project ships no AI credits.
#
# openai | anthropic | google | openrouter | ollama
# AI_PROVIDER=google
# AI_API_KEY=
# Pin a concrete stable model rather than a moving "-latest" alias: aliases
# repoint without warning and shed load first (intermittent 503s).
# AI_MODEL=gemini-2.5-flash
# For OpenRouter / local Ollama / any OpenAI-compatible endpoint.
# AI_BASE_URL=
# Cost guard rail.
# AI_DAILY_REQUEST_LIMIT=

# === Email ============================================================
# Notification emails, and the welcome email sent when an admin creates a user.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# Convenience: if RESEND_API_KEY is set and SMTP_HOST is not, mail goes via
# Resend's SMTP endpoint. Plain SMTP always wins when both are set -- no vendor
# is privileged here.
# RESEND_API_KEY=

# === Paths ============================================================
# Where the database, uploads and the auto-generated secrets.env live. Must be
# a persistent volume: if it isn't, every restart generates new keys and
# yesterday's photos become permanently unreadable.
#
# Falls back to repo-relative paths when the directory doesn't exist (tests, a
# bare dev checkout), so you normally don't set this outside a container.
# DATA_DIR=/data

# Encrypted photos and signatures.
# UPLOAD_DIR=

# Branding/feature-flag file.
# BRANDING_PATH=config/branding.yaml

# === Single-container mode (see docs/DEPLOY-ZEABUR.md) ================
# Only relevant when running the root Dockerfile as one service where the
# backend also serves the built SPA. The docker-compose + Caddy path pins
# PORT=8000 itself and ignores these.
#
# The platform usually injects PORT for you.
# PORT=8080
# Set 0 to run the API only (fronting the SPA with your own static host).
# SERVE_FRONTEND=1
# Path to the `vite build` output inside the image. Only read when
# SERVE_FRONTEND=1.
# FRONTEND_DIST=/app/frontend_dist

# === CORS =============================================================
# Leave unset/empty for same-origin-only (no CORS middleware at all -- the
# default, and correct for both deployment paths above). Only needed when the
# frontend is served from a different origin, e.g. `npm run dev` locally.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# === Configured elsewhere (NOT env vars) ==============================
# These are real features. They're just not configured here, and inventing env
# vars for them would do nothing:
#
# * Notification channels (LINE / Slack / Discord / Telegram / webhook):
#   admin UI. Channel tokens are encrypted at rest in the settings table.
#
# * Webhook / self-hosted-AI access to private network addresses: a per-
#   endpoint `allow_private_network` toggle on each webhook endpoint and AI
#   provider config (admin UI). Deliberately per-endpoint and opt-in -- there
#   is no global "turn the SSRF guard off" switch, because one endpoint needing
#   a LAN address is not a reason to let every endpoint reach your network.
#
# * Retention years, company name, logo, colours, pickup location, feature
#   toggles: config/branding.yaml (retention can also be overridden at runtime
#   from the settings table). See docs/BRANDING.md.
#
# * Backups: there is no built-in backup uploader. Back up the data volume and
#   your ENCRYPTION_KEY with whatever your org already uses. A database backup
#   without the key is unreadable noise -- make sure the key is in the plan.
